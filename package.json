{
  "name": "cybershield-root",
  "version": "1.0.0",
  "description": "CyberShield - MERN Cyber-Safety Portal",
  "main": "backend/server.js",
  "scripts": {
    "install-all": "npm install && npm install --prefix backend && npm install --prefix frontend --legacy-peer-deps",
    "build": "npm run install-all && npm run build --prefix frontend",
    "prestart": "npm run build --prefix frontend",
    "start": "node backend/server.js",
    "backend": "npm start --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\""
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exif-parser": "^0.1.12",
    "express": "^4.19.2",
    "mongoose": "^8.3.1",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "serverless-http": "^3.2.0"
  }
}
